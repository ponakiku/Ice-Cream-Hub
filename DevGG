-- Hàm lưu config
local function SaveConfig(configName)
    if configName == "" then return end
    local configData = {
        SavedSettings = SavedSettings,
        Toggles = {
            AutoAttack = AutoAttack,
            AutoFollowEnabled = AutoFollowEnabled,
            AutoSetDungeon = AutoSetDungeon,
            AutoStartDungeon = AutoStartDungeon,
            AutoGoAgain = AutoGoAgain,
            AutoGoLobby = AutoGoLobby
        },
        Sliders = {
            TweenDistance = TweenDistance,
            TweenSpeed = TweenSpeed,
            AttackCooldown = AttackCooldown
        }
    }
    local jsonData = HttpService:JSONEncode(configData)
    local filePath = ConfigFolder .. "/" .. configName .. ".json"
    local success, err = pcall(function()
        writefile(filePath, jsonData)
    end)
end

-- Hàm tải config
local function LoadConfig(configName)
    local filePath = ConfigFolder .. "/" .. configName .. ".json"
    if isfile(filePath) then
        local jsonData = readfile(filePath)
        local configData = HttpService:JSONDecode(jsonData)

        -- Áp dụng SavedSettings
        SavedSettings = configData.SavedSettings or SavedSettings

        -- Áp dụng toggle
        AutoAttack = configData.Toggles.AutoAttack or false
        AutoFollowEnabled = configData.Toggles.AutoFollowEnabled or false
        AutoSetDungeon = configData.Toggles.AutoSetDungeon or false
        AutoStartDungeon = configData.Toggles.AutoStartDungeon or false
        AutoGoAgain = configData.Toggles.AutoGoAgain or false
        AutoGoLobby = configData.Toggles.AutoGoLobby or false

        -- Áp dụng slider
        TweenDistance = configData.Sliders.TweenDistance or 50
        TweenSpeed = configData.Sliders.TweenSpeed or 25
        AttackCooldown = configData.Sliders.AttackCooldown or 0.25
    end
end

-- Hàm liệt kê config đã lưu
local function GetConfigList()
    local files = listfiles(ConfigFolder)
    local configList = {}
    for _, file in pairs(files) do
        local configName = file:match("IceCreamHubConfig/(.*)%.json")
        if configName then
            table.insert(configList, configName)
        end
    end
    return configList
end

