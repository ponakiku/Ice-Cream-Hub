-- Hàm tìm tất cả quái trong phạm vi
local function getMobsInRange()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return {}
	end

	local mobsInRange = {}
	local attackRange = math.min(TweenDistance, 500) -- Giới hạn khoảng cách tấn công
	local mobsFolder = workspace:FindFirstChild("Mobs")
	local scanTarget = mobsFolder or workspace -- Ưu tiên Mobs, fallback sang workspace

	local function scanMobs(folder)
		for _, mob in pairs(folder:GetChildren()) do
			if mob:IsA("Model") and mob:FindFirstChild("HumanoidRootPart") then
				local humanoid = mob:FindFirstChildOfClass("Humanoid")
				local mobPart = mob:FindFirstChild("HumanoidRootPart")
				if (humanoid and humanoid.Health > 0) or (mobPart and not humanoid) then
					local mobPos = mobPart.Position
					local playerPos = root.Position
					local distance = (Vector2.new(mobPos.X, mobPos.Z) - Vector2.new(playerPos.X, playerPos.Z)).Magnitude
					if distance <= attackRange then
						table.insert(mobsInRange, mob)
					end
				end
			elseif mob:IsA("Folder") then
				scanMobs(mob)
			end
		end
	end

	scanMobs(scanTarget)
	return mobsInRange
end

-- Hàm tìm quái gần nhất
local function getClosestMob()
	local mobs = workspace:WaitForChild("Mobs", 10)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not mobs or not root then
		return nil
	end

	local closest, dist = nil, math.huge
	local function scanMobs(folder)
		for _, mob in pairs(folder:GetChildren()) do
			if mob:IsA("Model") then
				local mobPart = mob:FindFirstChild("HumanoidRootPart")
				if mobPart then
					local mobPos = mobPart.Position
					local playerPos = root.Position
					local d = (Vector2.new(mobPos.X, mobPos.Z) - Vector2.new(playerPos.X, playerPos.Z)).Magnitude
					if d < dist then
						closest = mob
						dist = d
					end
				end
			elseif mob:IsA("Folder") then
				scanMobs(mob)
			end
		end
	end

	scanMobs(mobs)
	return closest
end

-- Vòng lặp auto tween
local currentTween = nil
local currentTarget = nil

RunService.Heartbeat:Connect(function()
	if AutoFollowEnabled and player.Character then
		local humanoid = player.Character:FindFirstChild("Humanoid")
		local hrp = player.Character:FindFirstChild("HumanoidRootPart")

		if humanoid and hrp and humanoid.Health > 0 then
			if not currentTarget or not currentTarget.Parent or not currentTarget:FindFirstChild("HumanoidRootPart") then
				currentTarget = getClosestMob()
			end

			if currentTarget then
				local targetPart = currentTarget:FindFirstChild("HumanoidRootPart")
				if targetPart then
					local destination = targetPart.Position + Vector3.new(0, TweenDistance, 0)

					local bp = hrp:FindFirstChild("FloatPosition") or Instance.new("BodyPosition")
					bp.Name = "FloatPosition"
					bp.MaxForce = Vector3.new(1e5, 1e5, 1e5)
					bp.Position = destination
					bp.P = 10000
					bp.D = 1000
					bp.Parent = hrp

					local tweenInfo =villenTweenInfo.new(1 / TweenSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
					local tweenGoal = { Position = destination }

					if currentTween then
						currentTween:Cancel()
					end

					currentTween = TweenService:Create(bp, tweenInfo, tweenGoal)
					currentTween:Play()
				else
					currentTarget = getClosestMob()
				end
			end
		end
	end
end)

-- Auto tấn công
task.spawn(function()
	local lastAttackTime = 0
	while true do
		if AutoAttack and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
			local currentTime = os.clock()
			if currentTime - lastAttackTime >= AttackCooldown then
				local mobs = getMobsInRange()
				local combatRemote = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Combat") and ReplicatedStorage.Systems.Combat:FindFirstChild("PlayerAttack")
				
				if #mobs > 0 and combatRemote then
					local args = { mobs }
					pcall(function()
						combatRemote:FireServer(unpack(args))
					end)
					lastAttackTime = currentTime
				end
			end
		end
		task.wait(0.1) -- Giảm wait để vòng lặp chạy nhanh hơn
	end
end)

