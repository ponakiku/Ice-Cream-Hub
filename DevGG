-- Vòng lặp Auto Tween
RunService.Heartbeat:Connect(function()
    if not IsInLobby() and AutoFollowEnabled and player.Character then
        local humanoid = player.Character:FindFirstChild("Humanoid")
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")

        if humanoid and hrp and humanoid.Health > 0 then
            if not currentTarget or not currentTarget.Parent or not currentTarget:FindFirstChild("HumanoidRootPart") then
                currentTarget = getClosestMob()
            end

            if currentTarget then
                local targetPart = currentTarget:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local destination = targetPart.Position + Vector3.new(0, TweenDistance, 0)

                    local bp = hrp:FindFirstChild("FloatPosition") or Instance.new("BodyPosition")
                    bp.Name = "FloatPosition"
                    bp.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                    bp.Position = destination
                    bp.P = 10000
                    bp.D = 1000
                    bp.Parent = hrp

                    local tweenInfo = TweenInfo.new(1 / TweenSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                    local tweenGoal = { Position = destination }

                    if currentTween then
                        currentTween:Cancel()
                    end

                    currentTween = TweenService:Create(bp, tweenInfo, tweenGoal)
                    currentTween:Play()
                else
                    currentTarget = getClosestMob()
                end
            end
        end
    end
end)

-- Vòng lặp Auto Attack
task.spawn(function()
    local lastAttackTime = 0
    while true do
        if not IsInLobby() and AutoAttack and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            local currentTime = os.clock()
            if currentTime - lastAttackTime >= AttackCooldown then
                local mobs = getMobsInRange()
                local combatRemote = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Combat") and ReplicatedStorage.Systems.Combat:FindFirstChild("PlayerAttack")
                
                if #mobs > 0 and combatRemote then
                    local args = { mobs }
                    pcall(function()
                        combatRemote:FireServer(unpack(args))
                    end)
                    lastAttackTime = currentTime
                end
            end
        end
        task.wait(0.1)
    end
end)

