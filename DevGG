-- Noclip functions
function noclip()
    Clip = false
    local function Nocl()
        if Clip == false and game.Players.LocalPlayer.Character ~= nil then
            for _, v in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do
                if v:IsA('BasePart') and v.CanCollide and v.Name ~= "FloatPosition" then
                    v.CanCollide = false
                end
            end
        end
        wait(0.21)
    end
    Noclip = game:GetService('RunService').Stepped:Connect(Nocl)
end

function clip()
    if Noclip then Noclip:Disconnect() end
    Clip = true
end

-- Hàm tìm tất cả quái trong phạm vi
local function getMobsInRange()
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return {} end

    local mobsInRange = {}
    local attackRange = math.min(TweenDistance, 1000)
    local mobsFolder = workspace:FindFirstChild("Mobs")
    local scanTarget = mobsFolder or workspace

    local function scanMobs(folder)
        for _, mob in pairs(folder:GetChildren()) do
            if mob:IsA("Model") and mob:FindFirstChild("HumanoidRootPart") then
                local humanoid = mob:FindFirstChildOfClass("Humanoid")
                local mobPart = mob:FindFirstChild("HumanoidRootPart")
                if (humanoid and humanoid.Health > 0) or (mobPart and not humanoid) then
                    local mobPos = mobPart.Position
                    local playerPos = root.Position
                    local distance = (Vector2.new(mobPos.X, mobPos.Z) - Vector2.new(playerPos.X, playerPos.Z)).Magnitude
                    if distance <= attackRange then
                        table.insert(mobsInRange, mob)
                    end
                end
            elseif mob:IsA("Folder") then
                scanMobs(mob)
            end
        end
    end

    scanMobs(scanTarget)
    return mobsInRange
end

-- Hàm tìm quái gần nhất
local function getClosestMob()
    local mobs = workspace:WaitForChild("Mobs", 10)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not mobs or not root then return nil end

    local closest, dist = nil, math.huge
    local function scanMobs(folder)
        for _, mob in pairs(folder:GetChildren()) do
            if mob:IsA("Model") then
                local mobPart = mob:FindFirstChild("HumanoidRootPart")
                if mobPart then
                    local mobPos = mobPart.Position
                    local playerPos = root.Position
                    local d = (Vector2.new(mobPos.X, mobPos.Z) - Vector2.new(playerPos.X, playerPos.Z)).Magnitude
                    if d < dist then
                        closest = mob
                        dist = d
                    end
                end
            elseif mob:IsA("Folder") then
                scanMobs(mob)
            end
        end
    end

    scanMobs(mobs)
    return closest
end

